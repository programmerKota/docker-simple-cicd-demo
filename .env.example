JARVIS_ENV=production
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
JARVIS_DATA_DIR=./data
JARVIS_BACKUP_DIR=./backups
JARVIS_MASTER_KEY_FILE=./master.key
JARVIS_SESSION_SECRET=replace-with-at-least-32-random-characters
JARVIS_ADMIN_USERNAME=admin
JARVIS_ADMIN_PASSWORD=replace-this-now
JARVIS_ALLOWED_ORIGINS=http://localhost:8787
JARVIS_TRUSTED_HOSTS=localhost,127.0.0.1
JARVIS_OLLAMA_URL=http://host.docker.internal:11434
JARVIS_OLLAMA_MODEL=qwen3:8b
JARVIS_HOME_ASSISTANT_URL=http://homeassistant.local:8123
JARVIS_HOME_ASSISTANT_TOKEN=
JARVIS_ENABLE_SHELL=false
JARVIS_SHELL_ALLOWLIST=python,python3,pwsh,powershell,git
JARVIS_WORKSPACE_ROOTS=
JARVIS_ENABLE_PLUGINS=false
JARVIS_ENABLED_PLUGINS=
JARVIS_PIPER_COMMAND=
JARVIS_WHISPER_MODEL=small
JARVIS_LOG_LEVEL=INFO
