JARVIS_ENV=production
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
JARVIS_MCP_HOST=0.0.0.0
JARVIS_MCP_PORT=8790
JARVIS_MCP_TOKEN=replace-mcp-token
JARVIS_OPA_URL=http://opa:8181
JARVIS_DBOS_DATABASE_URL=
JARVIS_DBOS_PASSWORD=replace-dbos-password
JARVIS_STATE_WITNESS_ATTEMPTS=8
JARVIS_STATE_WITNESS_INTERVAL_SECONDS=1.0
JARVIS_NATS_URL=nats://nats:4222
JARVIS_NATS_TOKEN=replace-nats-token
JARVIS_NATS_STREAM=JARVIS_HOME_EVENTS
JARVIS_NATS_FLUSH_INTERVAL_SECONDS=1.0
JARVIS_DATA_DIR=./data
JARVIS_BACKUP_DIR=./backups
JARVIS_MASTER_KEY_FILE=./master.key
JARVIS_SESSION_SECRET=replace-session-secret
JARVIS_ADMIN_USERNAME=admin
JARVIS_ADMIN_PASSWORD=replace-admin-password
JARVIS_ALLOWED_ORIGINS=http://localhost:8787
JARVIS_TRUSTED_HOSTS=localhost,127.0.0.1
JARVIS_OLLAMA_URL=http://host.docker.internal:11434
JARVIS_OLLAMA_MODEL=qwen3:8b
JARVIS_HOME_ASSISTANT_URL=http://homeassistant.local:8123
JARVIS_HOME_ASSISTANT_TOKEN=
JARVIS_ENABLE_SHELL=false
JARVIS_SHELL_ALLOWLIST=python,python3,pwsh,powershell,git
JARVIS_WORKSPACE_ROOTS=
JARVIS_ENABLE_PLUGINS=false
JARVIS_ENABLED_PLUGINS=
JARVIS_PIPER_COMMAND=
JARVIS_WHISPER_MODEL=small
JARVIS_LOG_LEVEL=INFO
OPENJARVIS_API_KEY=replace-openjarvis-api-key
